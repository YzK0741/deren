<rml>
<head><title>deren RmlUi</title><style>
body { margin: 0; font-family: LatoLatin; font-size: 18px; color: #e9eef4; }
#panel { position: absolute; left: 20px; top: 20px; width: 320px; height: 220px; background-color: #202936e8; border: 1px #71849a; }
h1 { position: absolute; left: 16px; top: 10px; margin: 0; font-size: 24px; }
#status { position: absolute; left: 16px; top: 55px; }
#name { position: absolute; left: 16px; top: 108px; width: 260px; height: 28px; background-color: #111820; color: #ffffff; border: 1px #6d8299; }
button { position: absolute; left: 16px; top: 155px; width: 150px; height: 32px; background-color: #335b80; }
button:hover { background-color: #487dab; }
button:active { background-color: #6b9bc1; }
img { position: absolute; left: 278px; top: 15px; width: 24px; height: 24px; }
</style></head>
<body><div id="panel"><h1>deren RmlUi</h1><img src="checker.png"/><div id="status">Type a name below</div><input id="name" type="text"/><button id="apply">Apply</button></div></body>
</rml>
