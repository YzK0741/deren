<rml>
<head><title>deren RmlUi</title><style>
body { width: 100%; height: 100%; margin: 0; font-family: LatoLatin; font-size: 18dp; color: #e9eef4; }
#panel { position: absolute; left: 20dp; top: 20dp; width: 320dp; height: 220dp; background-color: #202936e8; border: 1dp #71849a; }
h1 { position: absolute; left: 16dp; top: 10dp; margin: 0; font-size: 24dp; }
#status { position: absolute; left: 16dp; top: 55dp; }
#name { position: absolute; left: 16dp; top: 108dp; width: 260dp; height: 28dp; background-color: #111820; color: #ffffff; border: 1dp #6d8299; }
button { position: absolute; left: 16dp; top: 155dp; width: 150dp; height: 32dp; background-color: #335b80; }
button:hover { background-color: #487dab; }
button:active { background-color: #6b9bc1; }
img { position: absolute; left: 278dp; top: 15dp; width: 24dp; height: 24dp; }
</style></head>
<body><div id="panel"><h1>deren RmlUi</h1><img src="checker.png"/><div id="status">Type a name below</div><input id="name" type="text"/><button id="apply">Apply</button></div></body>
</rml>
