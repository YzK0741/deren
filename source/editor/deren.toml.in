[project]
name = "deren editor"
# The editor project is authored in source/editor and REUSED in place, exactly like the demo game:
# the entry scene points at the source TOML so the build tree keeps no copy of authored data.
main_scene = "@DEREN_EDITOR_SCENE@"

[paths]
asset_library = "@DEREN_REPO_ROOT@/asset"

[scripts]
# absolute: the managed assemblies are built into the build tree, not beside this manifest
assembly = "@DEREN_EDITOR_ASSEMBLY@"
