<rml>
<head><title>deren editor</title><style>
/* Slate-inspired hierarchy: background #151515, recessed #1a1a1a, panel #242424,
   header #2f2f2f, input #0f0f0f and primary #0070e0. See UE StyleColors.cpp. */
body { width: 100%; height: 100%; margin: 0; font-family: LatoLatin; font-size: 13dp; color: #c0c0c0; background-color: #151515; display: flex; flex-direction: column; }
button { cursor: pointer; }
input[type="text"] { color: #e0e0e0; line-height: 15dp; }
input[type="text"]:placeholder-shown { color: #9a9fa5; }
#menubar { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; height: 30dp; flex-shrink: 0; padding: 0 12dp; background-color: #151515; border-bottom: 1dp #0f0f0f; }
#brand { width: 76dp; color: #efefef; font-size: 16dp; letter-spacing: 1dp; pointer-events: none; }
.menu { box-sizing: border-box; height: 26dp; padding: 0 12dp; font-size: 13dp; line-height: 26dp; color: #c0c0c0; border-radius: 3dp; }
.menu:hover { background-color: #383838; color: #ffffff; }
.menu_dropdown { display: block; position: absolute; top: 30dp; width: 224dp; padding: 5dp; background-color: #2a2a2a; border: 1dp #454545; border-radius: 4dp; z-index: 20; }
.menu_item { display: block; box-sizing: border-box; width: 100%; height: 29dp; padding: 0 10dp; font-size: 13dp; line-height: 29dp; border-radius: 2dp; white-space: nowrap; }
.menu_item:hover { background-color: #0070e0; color: #ffffff; }
#project_label { flex-grow: 1; font-size: 12dp; line-height: 26dp; text-align: right; color: #858585; }
#toolbar { display: flex; flex-direction: row; align-items: center; box-sizing: border-box; height: 50dp; flex-shrink: 0; padding: 0 14dp; background-color: #242424; border-bottom: 1dp #0f0f0f; }
#toolbar button { box-sizing: border-box; height: 30dp; line-height: 28dp; margin-right: 6dp; padding: 0 13dp; background-color: #303030; border: 1dp #414141; border-radius: 3dp; color: #d0d0d0; font-size: 13dp; text-align: center; }
#toolbar button:hover { background-color: #454545; border-color: #606060; color: #ffffff; }
#toolbar button:active { background-color: #1b1b1b; }
#toolbar #btn_new { background-color: #22573a; border-color: #35734e; color: #d6f0df; }
#toolbar #btn_new:hover { background-color: #2e714c; }
#toolbar #btn_save { background-color: #0070e0; border-color: #0070e0; color: #ffffff; }
#toolbar #btn_save:hover { background-color: #0e86ff; }
#toolbar #btn_play { background-color: #22573a; border-color: #35734e; color: #d6f0df; }
#toolbar #btn_play:hover { background-color: #2e714c; }
#toolbar #btn_delete:hover { background-color: #673735; border-color: #9e4d49; }
.toolbar_separator { width: 1dp; height: 24dp; margin: 0 12dp 0 6dp; background-color: #424242; }
#rename_field { box-sizing: border-box; width: 200dp; height: 29dp; margin-right: 6dp; padding: 6dp 9dp; background-color: #0f0f0f; border: 1dp #383838; border-radius: 3dp; font-size: 13dp; }
#toolbar_note { flex-grow: 1; text-align: right; font-size: 11dp; color: #787878; }
#main { display: flex; flex-direction: row; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
#left_area { display: flex; flex-direction: column; flex-grow: 1; flex-shrink: 1; flex-basis: 0; height: 100%; min-width: 0; }
#viewport_panel { display: flex; flex-direction: column; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
#viewport_toolbar { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; height: 34dp; flex-shrink: 0; padding: 0 9dp; background-color: #1a1a1a; border-bottom: 1dp #101010; }
#viewport_toolbar button { box-sizing: border-box; height: 24dp; line-height: 22dp; margin-right: 3dp; padding: 0 11dp; background-color: #2a2a2a; border: 1dp #383838; border-radius: 3dp; color: #c0c0c0; font-size: 12dp; text-align: center; }
#viewport_toolbar button:hover { background-color: #454545; color: #ffffff; }
#viewport_mode { flex-grow: 1; font-size: 12dp; line-height: 30dp; text-align: right; color: #9b9b9b; }
#viewport { position: relative; display: flex; flex-direction: row; align-items: center; justify-content: center; flex-grow: 1; flex-shrink: 1; flex-basis: 0; overflow: hidden; background-color: #111111; }
#viewport_image { width: 100%; height: 100%; }
#box_outline { position: absolute; display: none; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
.box_edge { position: absolute; height: 2dp; transform-origin: 0 50%; background-color: #ffbc64; pointer-events: none; }
#box_outline .solid_edge { background-color: #74d7ef; }
.gizmo_axis { display: none; position: absolute; width: 58dp; height: 2dp; transform-origin: 0 50%; pointer-events: none; z-index: 2; }
.gizmo_tip { position: absolute; right: 0; top: -3dp; width: 8dp; height: 8dp; border-radius: 2dp; pointer-events: none; }
#gizmo_x, #gizmo_x .gizmo_tip { background-color: #ff6b69; }
#gizmo_y, #gizmo_y .gizmo_tip { background-color: #78dc7d; }
#gizmo_z, #gizmo_z .gizmo_tip { background-color: #6fb1ff; }
.split_v { box-sizing: border-box; width: 5dp; height: 100%; background-color: #101010; cursor: e-resize; }
.split_h { box-sizing: border-box; width: 100%; height: 5dp; flex-shrink: 0; background-color: #101010; cursor: n-resize; }
.split_v:hover, .split_h:hover { background-color: #0070e0; }
#bottom_dock { box-sizing: border-box; display: flex; flex-direction: column; height: 244dp; flex-shrink: 0; overflow: hidden; background-color: #242424; border-top: 1dp #353535; }
#dock_tabs { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; height: 33dp; flex-shrink: 0; background-color: #191919; border-bottom: 1dp #0f0f0f; }
.dock_tab { box-sizing: border-box; height: 33dp; padding: 0 17dp; font-size: 13dp; line-height: 31dp; color: #929292; border-bottom: 2dp transparent; }
.dock_tab:hover { background-color: #2f2f2f; color: #ffffff; }
.dock_tab.active { color: #efefef; background-color: #242424; border-bottom: 2dp #0070e0; }
#dock_body { box-sizing: border-box; flex-grow: 1; flex-shrink: 1; min-height: 0; flex-basis: 0; padding: 12dp 14dp; overflow: hidden; }
.dock_note { display: block; font-size: 13dp; color: #8c8c8c; }
#log_body { display: none; flex-direction: column; height: 100%; }
#output_header { flex-shrink: 0; margin-bottom: 6dp; }
#output_clear { padding: 3dp 9dp; background-color: #303030; border: 1dp #414141; }
#output_lines { flex-grow: 1; flex-basis: 0; min-height: 0; overflow: auto; }
.output_message { display: block; padding: 3dp 6dp; color: #cdcdcd; white-space: pre-wrap; }
.output_error, .output_link { color: #ffafa6; }
.output_link { cursor: pointer; }
.output_link:hover { background-color: #3e3533; color: #fff; }
#browser_body { display: flex; flex-direction: column; height: 100%; }
#browser_bar { display: flex; flex-direction: row; align-items: center; height: 28dp; flex-shrink: 0; margin-bottom: 5dp; }
#browser_search { box-sizing: border-box; width: 280dp; height: 27dp; padding: 5dp 9dp; background-color: #0f0f0f; border: 1dp #383838; border-radius: 3dp; font-size: 12dp; }
#browser_import, #browser_refresh, #browser_thumbnail, #browser_edit_asset { box-sizing: border-box; height: 27dp; margin-left: 8dp; padding: 0 10dp; line-height: 25dp; background-color: #303030; border: 1dp #414141; border-radius: 3dp; color: #d0d0d0; font-size: 12dp; }
#browser_import:hover, #browser_refresh:hover, #browser_thumbnail:hover, #browser_edit_asset:hover { background-color: #414141; color: #fff; }
.asset_thumbnail { display: none; position: absolute; top: 4dp; left: 3dp; width: 112dp; height: 70dp; pointer-events: none; }
#browser_count { flex-grow: 1; font-size: 12dp; line-height: 27dp; text-align: right; color: #929292; }
#browser_navigation { display: flex; align-items: center; height: 25dp; flex-shrink: 0; margin-bottom: 5dp; }
.browser_nav_button { box-sizing: border-box; height: 23dp; margin-right: 5dp; padding: 0 8dp; line-height: 21dp; background-color: #303030; border: 1dp #414141; border-radius: 3dp; font-size: 11dp; }
.browser_nav_button:hover { background-color: #414141; color: #fff; }
#browser_location { flex-grow: 1; color: #a9bed1; padding: 0 4dp; font-size: 12dp; white-space: nowrap; overflow: hidden; }
#browser_paging { display: none; flex-shrink: 0; align-items: center; }
#browser_page { color: #bcbcbc; font-size: 11dp; margin: 0 8dp 0 3dp; }
.asset_folder { display: block; position: absolute; left: 39dp; top: 27dp; width: 38dp; height: 26dp; background-color: #85653f; border: 1dp #c5a36f; border-radius: 3dp; pointer-events: none; }
.asset_folder .asset_cube_inner { left: 3dp; top: -6dp; width: 17dp; height: 5dp; background-color: #a17b45; border: 1dp #c5a36f; }
.asset_kind { white-space: nowrap; overflow: hidden; }
#asset_grid_host { display: flex; flex-grow: 1; flex-shrink: 1; min-height: 0; flex-basis: 0; }
#asset_grid { display: flex; flex-direction: row; flex-wrap: wrap; align-content: flex-start; flex-grow: 1; flex-shrink: 1; min-height: 0; flex-basis: 0; overflow: auto; }
.browser_tile { box-sizing: border-box; width: 120dp; height: 124dp; margin: 0 10dp 10dp 0; background-color: #2d2d2d; border: 1dp #3c3c3c; border-bottom: 3dp #0070e0; border-radius: 3dp; cursor: pointer; }
.browser_tile:hover { background-color: #383838; border-color: #686868; border-bottom-color: #0e86ff; }
.asset_preview { display: block; width: 100%; position: relative; height: 79dp; background-color: #1e1e1e; border-bottom: 1dp #383838; pointer-events: none; }
.asset_cube { display: block; position: absolute; left: 43dp; top: 23dp; width: 29dp; height: 29dp; border: 1dp #738699; border-radius: 3dp; pointer-events: none; }
.asset_cube_inner { display: block; position: absolute; left: 5dp; top: 5dp; width: 17dp; height: 17dp; border: 1dp #455a70; pointer-events: none; }
.asset_kind { display: block; padding-left: 8dp; font-size: 10dp; line-height: 14dp; color: #7f8a95; pointer-events: none; }
.browser_tile_name { display: block; box-sizing: border-box; width: 100%; height: 25dp; padding: 0 8dp; font-size: 12dp; line-height: 25dp; color: #d4d4d4; white-space: nowrap; overflow: hidden; }
#right_column { box-sizing: border-box; display: flex; flex-direction: column; width: 350dp; height: 100%; flex-shrink: 0; background-color: #242424; }
#outliner { box-sizing: border-box; display: flex; flex-direction: column; width: 100%; height: 254dp; flex-shrink: 0; overflow: hidden; background-color: #202020; }
#outliner_header { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; height: 34dp; flex-shrink: 0; padding: 0 11dp; font-size: 13dp; line-height: 34dp; color: #dedede; background-color: #2f2f2f; border-bottom: 1dp #101010; }
#outliner_title { flex-grow: 1; }
#outliner_search { box-sizing: border-box; width: 135dp; height: 23dp; padding: 3dp 7dp; background-color: #0f0f0f; border: 1dp #414141; border-radius: 3dp; font-size: 12dp; }
#outliner_columns { height: 24dp; flex-shrink: 0; padding: 0 12dp; font-size: 11dp; line-height: 24dp; color: #858585; background-color: #242424; border-bottom: 1dp #303030; pointer-events: none; }
#outliner_root_drop { height: 22dp; flex-shrink: 0; line-height: 22dp; padding-left: 12dp; font-size: 11dp; color: #a9a9a9; background-color: #282828; }
#outliner_root_drop:hover { background-color: #36495b; }
.row_fold { flex-shrink: 0; width: 18dp; height: 24dp; line-height: 24dp; text-align: center; color: #a9a9a9; }
.row_fold:hover { color: #fff; }
#outliner_rows { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; overflow: auto; padding: 3dp 0; }
.row { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; height: 25dp; padding-left: 11dp; white-space: nowrap; border-bottom: 1dp #252525; }
.row:hover { background-color: #333333; }
.row_name { flex-grow: 1; font-size: 12dp; line-height: 25dp; color: #c7c7c7; white-space: pre; pointer-events: none; }
.row_vis { box-sizing: border-box; width: 27dp; font-size: 12dp; line-height: 25dp; text-align: center; color: #8c8c8c; cursor: pointer; }
.row_vis:hover { color: #ffffff; }
#details { box-sizing: border-box; width: 100%; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; padding: 12dp; overflow: auto; background-color: #242424; }
#details_title { display: block; box-sizing: border-box; height: 31dp; font-size: 14dp; line-height: 26dp; color: #e0e0e0; border-bottom: 1dp #414141; margin-bottom: 10dp; white-space: nowrap; overflow: hidden; }
#details_empty { display: block; margin-top: 30dp; padding: 14dp; font-size: 12dp; line-height: 20dp; color: #909090; text-align: center; background-color: #202020; border: 1dp #303030; border-radius: 4dp; }
#details_form { display: none; }
#environment_group { display: block; }
.detail_header { display: block; box-sizing: border-box; height: 29dp; padding: 0 7dp; margin-top: 12dp; margin-bottom: 4dp; font-size: 11dp; line-height: 29dp; color: #c3c3c3; background-color: #2e2e2e; border-bottom: 1dp #393939; text-transform: uppercase; }
.detail_row { display: flex; flex-direction: row; align-items: center; box-sizing: border-box; height: 30dp; border-bottom: 1dp #2b2b2b; }
.detail_label { box-sizing: border-box; width: 82dp; flex-shrink: 0; font-size: 12dp; line-height: 28dp; color: #a8a8a8; }
.detail_text { box-sizing: border-box; flex-grow: 1; height: 23dp; font-size: 12dp; line-height: 23dp; padding: 0 7dp; color: #929292; background-color: #1a1a1a; border: 1dp #333333; border-radius: 2dp; white-space: nowrap; overflow: hidden; }
.script_select { flex-grow: 1; min-width: 0; color: #e0e0e0; background-color: #181818; border: 1dp #383838; font-size: 12dp; }
.script_select selectbox { background-color: #252525; border: 1dp #4a4a4a; max-height: 230dp; }
.script_select option { padding: 4dp 7dp; }
.script_select option:hover, .script_select option:checked { background-color: #224c78; }
#script_refresh, .script_apply { margin-left: 5dp; padding: 3dp 7dp; color: #d0d0d0; background-color: #303030; border: 1dp #414141; }
#details input { box-sizing: border-box; flex-grow: 1; min-width: 0; height: 23dp; padding: 3dp 7dp; background-color: #0f0f0f; border: 1dp #383838; border-radius: 2dp; color: #dedede; font-size: 12dp; }
#details .axis_input { width: 0; padding: 3dp 4dp; text-align: right; margin-right: 4dp; }
/* The environment dropdowns reuse the project look field's popup shape so the two selects in the editor behave alike. */
select.env_select { box-sizing: border-box; flex-grow: 1; min-width: 0; height: 23dp; padding: 0 7dp; padding-right: 23dp; background-color: #0f0f0f; border: 1dp #383838; border-radius: 2dp; color: #dedede; font-size: 12dp; cursor: pointer; }
select.env_select:focus { border-color: #0070e0; }
select.env_select selectarrow { width: 0; height: 0; margin-top: 9dp; margin-right: 8dp; border-left: 4dp transparent; border-right: 4dp transparent; border-top: 5dp #b9c5d3; pointer-events: none; }
select.env_select selectbox { box-sizing: border-box; width: 100%; margin-top: 2dp; padding: 2dp; background-color: #252525; border: 1dp #505050; border-radius: 3dp; }
select.env_select option { display: block; box-sizing: border-box; height: 26dp; line-height: 26dp; padding: 0 8dp; white-space: nowrap; color: #e5e5e5; }
select.env_select option:checked { background-color: #234d74; }
select.env_select option:hover { background-color: #32658e; color: #ffffff; }
.axis { width: 13dp; flex-shrink: 0; height: 23dp; font-size: 10dp; line-height: 23dp; text-align: center; color: #eeeeee; border-radius: 2dp; pointer-events: none; }
.axis_x { background-color: #804444; }
.axis_y { background-color: #4d7346; }
.axis_z { background-color: #3e6288; }
#detail_visible, #detail_trigger_target, #detail_collision_box, #detail_trigger_volume { box-sizing: border-box; height: 23dp; padding: 0 9dp; background-color: #343434; border: 1dp #494949; border-radius: 3dp; color: #c0c0c0; font-size: 12dp; }
#detail_visible:hover, #detail_trigger_target:hover, #detail_collision_box:hover, #detail_trigger_volume:hover { background-color: #464646; }
input:focus { border-color: #0070e0; }
#status { box-sizing: border-box; height: 25dp; flex-shrink: 0; padding: 0 13dp; background-color: #1a1a1a; border-top: 1dp #383838; font-size: 11dp; line-height: 25dp; color: #929292; white-space: nowrap; }
scrollbarvertical { width: 9dp; background-color: #191919; }
scrollbarvertical sliderbar { background-color: #4b4b4b; border: 2dp #191919; border-radius: 4dp; }
scrollbarvertical sliderbar:hover { background-color: #686868; }
#unsaved_prompt, #scene_path_prompt, #asset_import_prompt, #asset_edit_prompt { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 100; background-color: #000000b0; align-items: center; justify-content: center; }
#unsaved_dialog, #scene_path_dialog { box-sizing: border-box; width: 440dp; max-width: 94%; background-color: #242424; border: 1dp #4b4b4b; border-radius: 8dp; overflow: hidden; }
#unsaved_body, #scene_path_body { display: block; padding: 22dp 24dp 22dp; }
#unsaved_dialog h2, #scene_path_dialog h2 { display: block; margin: 0 0 8dp; color: #f0f0f0; font-size: 20dp; line-height: 26dp; }
#unsaved_message, #scene_path_message { display: block; color: #bcbcbc; font-size: 13dp; line-height: 20dp; }
#unsaved_actions, #scene_path_actions { display: flex; flex-direction: row; justify-content: flex-end; align-items: center; padding: 12dp 16dp; background-color: #1c1c1c; border-top: 1dp #363636; }
#unsaved_actions button, #scene_path_actions button { display: block; box-sizing: border-box; width: 92dp; min-width: 0; height: 34dp; line-height: 32dp; margin-left: 8dp; padding: 0 8dp; color: #dedede; background-color: #303030; border: 1dp #484848; border-radius: 4dp; text-align: center; }
#unsaved_actions button:hover, #unsaved_actions button:focus, #scene_path_actions button:hover, #scene_path_actions button:focus { background-color: #404040; border-color: #626262; color: #ffffff; }
#unsaved_actions #unsaved_discard { color: #f0b5b0; }
#unsaved_actions #unsaved_discard:hover, #unsaved_actions #unsaved_discard:focus { background-color: #522f2d; border-color: #90514d; }
#unsaved_actions #unsaved_save, #scene_path_actions #scene_path_accept { background-color: #0070e0; border-color: #2088ed; color: #ffffff; }
#unsaved_actions #unsaved_save:hover, #unsaved_actions #unsaved_save:focus, #scene_path_actions #scene_path_accept:hover, #scene_path_actions #scene_path_accept:focus { background-color: #0e82f2; border-color: #59abff; }
#scene_path { display: block; box-sizing: border-box; width: 100%; height: 31dp; margin-top: 12dp; padding: 7dp 9dp; background-color: #101010; border: 1dp #4a4a4a; border-radius: 3dp; }
#scene_path:focus { border-color: #0070e0; }
#detail_pipeline { text-align: left; }
#detail_pipeline:hover { border-color: #5a5a5a; }
 /* Borderless window controls: the editor draws them because the project sets [render]
   borderless_window - there is no system title bar to host them. The buttons sit flush with the
   window edge (the menu bar's own padding is cancelled on the right), close turns red on hover. */
#window_controls { display: flex; flex-direction: row; align-items: center; height: 30dp; flex-shrink: 0; margin-right: -12dp; }
.win_button { box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: center; width: 46dp; height: 30dp; padding: 0; margin: 0; border-width: 0dp; border-radius: 0; background-color: transparent; color: #d0d0d0; }
.win_button:hover { background-color: #383838; }
#win_close:hover { background-color: #c42b1c; }
.win_glyph { pointer-events: none; }
.win_glyph_min { width: 11dp; height: 1dp; background-color: #d0d0d0; }
.win_glyph_max { box-sizing: border-box; width: 9dp; height: 9dp; border: 1dp #d0d0d0; }
.win_glyph_close { width: 100%; height: 30dp; font-size: 15dp; line-height: 30dp; text-align: center; color: #d0d0d0; }
#asset_import_dialog, #asset_edit_dialog { width: 560dp; background-color: #242424; border: 1dp #424242; border-radius: 5dp; }
#asset_import_body, #asset_edit_body { padding: 19dp 22dp; }
#asset_import_body h2, #asset_edit_body h2 { margin: 0 0 12dp; font-size: 19dp; color: #efefef; }
#asset_import_message, #asset_edit_message { color: #c2c2c2; margin-bottom: 14dp; font-size: 13dp; }
.asset_import_row { display: flex; align-items: center; margin-bottom: 8dp; }
.asset_import_label { width: 72dp; color: #c2c2c2; }
.asset_import_field { flex-grow: 1; min-width: 0; padding: 5dp 8dp; height: 20dp; color: #eeeeee; background-color: #111111; border: 1dp #454545; }
.asset_import_button { padding: 5dp 11dp; margin-left: 8dp; background-color: #303030; border: 1dp #444444; border-radius: 3dp; }
.asset_import_button:hover { background-color: #414141; }
#asset_import_actions, #asset_edit_actions { display: flex; justify-content: flex-end; padding: 12dp 20dp; background-color: #1c1c1c; border-top: 1dp #3a3a3a; }
#asset_import_accept, #asset_edit_save { background-color: #0070e0; border-color: #137dee; min-width: 65dp; text-align: center; }
#asset_import_accept:hover, #asset_edit_save:hover { background-color: #1685f4; }
#project_scenes_prompt, #project_settings_prompt, #input_actions_prompt { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 100; align-items: center; justify-content: center; background-color: #00000088; }
#project_settings_prompt { justify-content: flex-end; background-color: #00000016; }
.project_dialog { width: 490dp; max-width: 94%; max-height: 93%; display: flex; flex-direction: column; overflow: hidden; background-color: #242424; border: 1dp #4b4b4b; border-radius: 6dp; }
#project_settings_dialog { margin-right: 18dp; width: 410dp; }
.project_dialog_body { padding: 18dp 20dp; overflow: auto; }
.project_dialog_body h2 { display: block; margin: 0 0 10dp; color: #f0f0f0; font-size: 19dp; line-height: 24dp; }
.project_dialog_message { min-height: 18dp; margin-top: 9dp; color: #bcbcbc; font-size: 13dp; }
#project_settings_file { color: #9d9d9d; font-size: 12dp; margin-bottom: 14dp; }
#project_scenes_list { height: 240dp; max-height: 40vh; overflow: auto; background-color: #1a1a1a; border: 1dp #383838; }
.project_scene_row { display: block; box-sizing: border-box; width: 100%; padding: 7dp 9dp; text-align: left; color: #dddddd; }
.project_scene_row:hover { background-color: #333333; }
.project_scene_selected { background-color: #234d74; color: #ffffff; }
.project_look_row { display: flex; align-items: center; margin-bottom: 8dp; }
.project_look_label { width: 130dp; color: #c5c5c5; }
.project_look_field { flex-grow: 1; min-width: 0; background-color: #151515; border: 1dp #444444; color: #eeeeee; padding: 4dp 7dp; }
select.project_look_field { cursor: pointer; padding-right: 23dp; }
select.project_look_field:focus { border-color: #4087c9; }
select.project_look_field selectarrow { width: 0; height: 0; margin-top: 10dp; margin-right: 8dp; border-left: 4dp transparent; border-right: 4dp transparent; border-top: 5dp #b9c5d3; pointer-events: none; }
select.project_look_field selectbox { box-sizing: border-box; width: 100%; margin-top: 2dp; padding: 2dp; background-color: #252525; border: 1dp #505050; border-radius: 3dp; }
select.project_look_field option { display: block; box-sizing: border-box; height: 26dp; line-height: 26dp; padding: 0 8dp; white-space: nowrap; color: #e5e5e5; }
select.project_look_field option:checked { background-color: #234d74; }
select.project_look_field option:hover { background-color: #32658e; color: #ffffff; }
#input_actions_list { max-height: 190dp; overflow-y: auto; margin: 8dp 0; }
#input_actions_list .project_scene_row { display: flex; justify-content: space-between; }
#input_actions_list .project_scene_row span { pointer-events: none; }
.input_key_summary { color: #a0b5c8; margin-left: 14dp; }
#input_action_edit { border-top: 1dp #404040; padding-top: 9dp; }
#input_action_keys { min-height: 26dp; margin: 5dp 0; }
.input_key_chip, .input_action_button { padding: 4dp 8dp; margin: 3dp 5dp 3dp 0; background-color: #303030; border: 1dp #484848; border-radius: 3dp; }
.input_key_chip:hover, .input_action_button:hover { background-color: #444444; }
.project_dialog_actions { display: flex; justify-content: flex-end; padding: 12dp 16dp; background-color: #1c1c1c; border-top: 1dp #383838; }
.project_dialog_actions button { padding: 6dp 10dp; margin-left: 7dp; color: #dddddd; background-color: #303030; border: 1dp #484848; border-radius: 4dp; }
.project_dialog_actions button:hover { background-color: #424242; }
.project_dialog_actions .project_primary { background-color: #0070e0; border-color: #2088ed; color: #ffffff; }
.project_dialog_actions .project_primary:hover { background-color: #1081f4; }
#camera_details, #material_details, #audio_source_details { display: none; }
.authoring_buttons button { margin: 2dp 6dp 3dp 0; padding: 4dp 8dp; background-color: #2c2c2c; border: 1dp #464646; border-radius: 3dp; }
.authoring_buttons button:hover { background-color: #3d3d3d; }
#point_light_details { display: none; }
.light_value { flex-grow: 1; min-width: 0; background-color: #111111; border: 1dp #444444; padding: 3dp 7dp; }
#light_apply { padding: 4dp 10dp; color: #ffffff; background-color: #0070e0; border-radius: 3dp; }
#light_apply:hover { background-color: #1587fa; }
</style></head>
<body>
<div id="menubar">
<div id="brand">deren</div>
<div id="menu_file" class="menu">File</div>
<div id="menu_edit" class="menu">Edit</div>
<div id="menu_window" class="menu">Window</div>
<div id="menu_help" class="menu">Help</div>
<div id="project_label">deren editor</div>
<div id="window_controls">
<button id="win_minimize" class="win_button"><div class="win_glyph win_glyph_min"></div></button>
<button id="win_maximize" class="win_button"><div class="win_glyph win_glyph_max"></div></button>
<button id="win_close" class="win_button"><div class="win_glyph win_glyph_close">×</div></button>
</div>
</div>
<div id="menu_add_items" class="menu_dropdown" style="visibility: hidden; left: 14dp; top: 76dp;">
    <div id="menu_add_node" class="menu_item">Empty Node</div>
    <div id="menu_add_scene_instance" class="menu_item">Scene Instance...</div>
    <div id="menu_add_audio_source" class="menu_item">Audio Source</div>
    <div id="menu_add_collision_box" class="menu_item">Collision Box</div>
    <div id="menu_add_box_trigger" class="menu_item">Box Trigger</div>
    <div id="menu_add_camera" class="menu_item">Camera</div>
    <div id="menu_add_point_light" class="menu_item">Point Light</div>
</div>
<div id="menu_file_items" class="menu_dropdown" style="visibility: hidden; left: 88dp;">
    <div id="menu_file_new" class="menu_item">New Scene</div>
    <div id="menu_file_open" class="menu_item">Project Scenes...</div>
    <div id="menu_file_open_path" class="menu_item">Open Scene by Path...</div>
    <div id="menu_file_save" class="menu_item">Save Scene</div>
    <div id="menu_file_save_as" class="menu_item">Save Scene As...</div>
    <div id="menu_file_project_settings" class="menu_item">Project Settings...</div>
</div>
<div id="menu_edit_items" class="menu_dropdown" style="visibility: hidden; left: 137dp;">
    <div id="menu_edit_undo" class="menu_item">Undo</div>
    <div id="menu_edit_redo" class="menu_item">Redo</div>
    <div id="menu_edit_duplicate" class="menu_item">Duplicate Selection</div>
    <div id="menu_edit_delete" class="menu_item">Delete Node</div>
    <div id="menu_edit_rename" class="menu_item">Rename Node</div>
</div>
<div id="menu_window_items" class="menu_dropdown" style="visibility: hidden; left: 191dp;">
    <div id="menu_window_outliner" class="menu_item">World Outliner</div>
    <div id="menu_window_details" class="menu_item">Details</div>
    <div id="menu_window_browser" class="menu_item">Content Browser</div>
    <div id="menu_window_sidebar_side" class="menu_item">Move Sidebar Left</div>
    <div id="menu_window_dock_side" class="menu_item">Move Dock to Top</div>
    <div id="menu_window_panel_order" class="menu_item">Place Details First</div>
    <div id="menu_window_reset_layout" class="menu_item">Reset Layout</div>
</div>
<div id="menu_help_items" class="menu_dropdown" style="visibility: hidden; left: 268dp;">
    <div id="menu_help_about" class="menu_item">About deren editor</div>
</div>
<div id="toolbar">
<button id="btn_new">Add</button>
<button id="btn_delete">Delete</button>
<div class="toolbar_separator"></div>
<button id="btn_save">Save</button>
<button id="btn_undo">Undo</button>
<button id="btn_redo">Redo</button>
<button id="btn_play">Play</button>
<div class="toolbar_separator"></div>
<input id="rename_field" type="text" placeholder="Node name"/>
<button id="btn_rename">Rename</button>
<div id="toolbar_note">SCENE EDITOR</div>
</div>
<div id="main">
<div id="left_area">
<div id="viewport_panel">
<div id="viewport_toolbar">
<button id="vp_select">Select</button>
<button id="vp_move">Move</button>
<button id="vp_rotate">Rotate</button>
<button id="vp_scale">Scale</button>
<button id="vp_space">World</button>
<button id="vp_focus">Focus (F)</button>
<div id="viewport_mode">Perspective  /  Lit</div>
</div>
<div id="viewport">
    <img id="viewport_image" src="deren://scene"/>
    <div id="box_outline"></div>
    <div id="gizmo_x" class="gizmo_axis"><div class="gizmo_tip"></div></div>
    <div id="gizmo_y" class="gizmo_axis"><div class="gizmo_tip"></div></div>
    <div id="gizmo_z" class="gizmo_axis"><div class="gizmo_tip"></div></div>
</div>
</div>
<div id="split_bottom" class="split_h"></div>
<div id="bottom_dock">
<div id="dock_tabs">
<div id="tab_content" class="dock_tab active">Content Browser</div>
<div id="tab_log" class="dock_tab">Output Log</div>
</div>
<div id="dock_body">
<div id="browser_body">
    <div id="browser_bar">
        <input id="browser_search" type="text" placeholder="Search assets"/>
        <button id="browser_import">Import</button>
        <button id="browser_refresh">Refresh</button>
        <button id="browser_edit_asset">Edit Asset</button>
        <button id="browser_thumbnail">Build Thumbnail</button>
        <div id="browser_count"></div>
    </div>
    <div id="browser_navigation">
        <button id="browser_root" class="browser_nav_button">Root</button>
        <button id="browser_up" class="browser_nav_button">Up</button>
        <div id="browser_location">Assets</div>
        <div id="browser_paging">
            <button id="browser_prev" class="browser_nav_button">Previous</button>
            <div id="browser_page"></div>
            <button id="browser_next" class="browser_nav_button">Next</button>
        </div>
    </div>
    <div id="asset_grid_host"><div id="asset_grid"></div></div>
    <div id="browser_empty" class="dock_note">No assets in the library.</div>
</div>
<div id="log_body">
    <div id="output_header"><button id="output_clear">Clear</button></div>
    <div id="output_empty" class="dock_note">Play output will appear here.</div>
    <div id="output_lines"></div>
</div>
</div>
</div>
</div>
<div id="split_right" class="split_v"></div>
<div id="right_column">
<div id="outliner">
    <div id="outliner_header"><div id="outliner_title">World Outliner</div><input id="outliner_search" type="text" placeholder="Search"/></div>
    <div id="outliner_columns">ACTOR LABEL</div>
<div id="outliner_root_drop">Scene Root</div>
<div id="outliner_rows">
</div>
</div>
<div id="split_outliner" class="split_h"></div>
<div id="details">
    <div id="details_title">Details</div>
    <div id="details_empty">Select a node to edit its properties.</div>
    <div id="details_form">
        <div class="detail_row"><div class="detail_label">Name</div><input id="detail_name" type="text"/></div>
        <div id="audio_source_details">
            <div class="detail_header">Audio Source</div>
            <div class="detail_row"><div class="detail_label">Clip</div><select id="audio_file" class="env_select"></select></div>
            <div class="detail_row"><div class="detail_label">Volume</div><input class="detail_input" id="audio_volume" type="text"/></div>
            <div class="detail_row"><div class="detail_label">Loop</div><select id="audio_loop" class="env_select"><option value="off">Off</option><option value="on">On</option></select></div>
            <div class="authoring_buttons">
                <button id="audio_apply">Apply</button><button id="audio_preview">Preview</button>
                <button id="audio_stop">Stop</button><button id="audio_refresh">Refresh Files</button>
            </div>
        </div>
        <div class="detail_header">Transform</div>
        <div class="detail_row"><div class="detail_label">Location</div><div class="axis axis_x">X</div><input id="detail_position_x" class="axis_input" type="text"/><div class="axis axis_y">Y</div><input id="detail_position_y" class="axis_input" type="text"/><div class="axis axis_z">Z</div><input id="detail_position_z" class="axis_input" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Rotation</div><div class="axis axis_x">X</div><input id="detail_rotation_x" class="axis_input" type="text"/><div class="axis axis_y">Y</div><input id="detail_rotation_y" class="axis_input" type="text"/><div class="axis axis_z">Z</div><input id="detail_rotation_z" class="axis_input" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Scale</div><div class="axis axis_x">X</div><input id="detail_scale_x" class="axis_input" type="text"/><div class="axis axis_y">Y</div><input id="detail_scale_y" class="axis_input" type="text"/><div class="axis axis_z">Z</div><input id="detail_scale_z" class="axis_input" type="text"/></div>
        <div class="detail_header">Actor</div>
        <div class="detail_row"><div class="detail_label">Visible</div><button id="detail_visible">Visible: yes</button></div>
        <div class="detail_row"><div class="detail_label">Solid Box</div><button id="detail_collision_box">Disabled</button></div>
        <div class="detail_row"><div class="detail_label">Trigger Volume</div><button id="detail_trigger_volume">Disabled</button></div>
        <div class="detail_row"><div class="detail_label">Trigger Target</div><button id="detail_trigger_target">Disabled</button></div>
        <div class="detail_row"><div class="detail_label">Flags</div><input id="detail_flags" type="text"/></div>

        <div class="detail_row"><div id="detail_asset_label" class="detail_label">Asset</div><div id="detail_asset" class="detail_text">-</div></div>
        <div class="detail_row"><div class="detail_label">Pipeline</div><button id="detail_pipeline" class="detail_text">-</button></div>
        <div class="detail_row"><div class="detail_label">Environment</div><select id="detail_environment" class="env_select"></select></div>
        <div id="camera_details">
            <div class="detail_header">Camera</div>
            <div class="detail_row"><div class="detail_label">Vertical FOV</div><input class="detail_input" id="camera_fov" type="text"/></div>
            <div class="authoring_buttons"><button id="camera_apply_fov">Apply FOV</button></div>
            <div class="authoring_buttons">
                <button id="camera_view">View Camera</button><button id="camera_align">Align to View</button>
                <button id="camera_main">Set as Main Camera</button>
            </div>
        </div>
        <div id="material_details">
            <div class="detail_header">Material Override</div>
            <div class="detail_row"><div class="detail_label">Mode</div><div id="material_mode">Imported material</div></div>
            <div class="detail_row"><div class="detail_label">Tint RGB</div><input class="detail_input" id="material_tint" type="text"/></div>
            <div class="detail_row"><div class="detail_label">Metallic ×</div><input class="detail_input" id="material_metallic" type="text"/></div>
            <div class="detail_row"><div class="detail_label">Roughness ×</div><input class="detail_input" id="material_roughness" type="text"/></div>
            <div class="detail_row"><div class="detail_label">Emissive ×</div><input class="detail_input" id="material_emissive" type="text"/></div>
            <div class="authoring_buttons"><button id="material_apply">Apply</button><button id="material_reset">Reset</button></div>
        </div>
        <div id="point_light_details">
            <div class="detail_header">Point Light</div>
            <div class="detail_row"><label class="detail_label" for="light_colour">Color RGB</label><input id="light_colour" class="light_value" type="text"/></div>
            <div class="detail_row"><label class="detail_label" for="light_intensity">Intensity</label><input id="light_intensity" class="light_value" type="text"/></div>
            <div class="detail_row"><label class="detail_label" for="light_range">Range</label><input id="light_range" class="light_value" type="text"/></div>
            <div class="detail_row"><div class="detail_label"></div><button id="light_apply">Apply</button></div>
        </div>
        <div id="script_controls"></div>
    </div>
    <div id="environment_group">
        <div class="detail_header">Environment</div>
        <div id="environment_rows"></div>
        <div class="detail_row"><div class="detail_label">Status</div><div id="environment_status" class="detail_text">-</div></div>
    </div>
</div>
</div>
</div>
<div id="status"></div>
<div id="unsaved_prompt"><div id="unsaved_dialog">
    <div id="unsaved_body">
        <h2>Unsaved changes</h2>
        <div id="unsaved_message">Save your changes before creating a new scene?</div>
    </div>
    <div id="unsaved_actions">
        <button id="unsaved_cancel">Cancel</button>
        <button id="unsaved_discard">Discard</button>
        <button id="unsaved_save">Save</button>
    </div>
</div></div>
<div id="scene_path_prompt"><div id="scene_path_dialog">
    <div id="scene_path_body">
        <h2 id="scene_path_title">Open Scene</h2>
        <div id="scene_path_message">Enter a path relative to the project's scenes folder, or an absolute path.</div>
        <input id="scene_path" type="text" placeholder="example.scene.toml"/>
    </div>
    <div id="scene_path_actions">
        <button id="scene_path_cancel">Cancel</button>
        <button id="scene_path_accept">Open</button>
    </div>
</div></div>
<div id="asset_edit_prompt"><div id="asset_edit_dialog">
    <div id="asset_edit_body">
        <h2>Edit Asset</h2>
        <div id="asset_edit_message"></div>
        <div class="asset_import_row">
            <label class="asset_import_label" for="asset_edit_name">Name</label>
            <input class="asset_import_field" id="asset_edit_name" type="text"/>
        </div>
        <div class="asset_import_row">
            <label class="asset_import_label" for="asset_edit_path">Folder</label>
            <input class="asset_import_field" id="asset_edit_path" type="text" placeholder="Path inside the library"/>
        </div>
    </div>
    <div id="asset_edit_actions">
        <button class="asset_import_button" id="asset_edit_cancel">Cancel</button>
        <button class="asset_import_button" id="asset_edit_save">Save</button>
    </div>
</div></div>
<div id="asset_import_prompt"><div id="asset_import_dialog">
    <div id="asset_import_body">
        <h2>Import Model</h2>
        <div id="asset_import_message"></div>
        <div class="asset_import_row">
            <label class="asset_import_label" for="asset_import_source">Source</label>
            <input class="asset_import_field" id="asset_import_source" type="text" placeholder="Path to .glb or .gltf"/>
            <button class="asset_import_button" id="asset_import_browse">Browse</button>
        </div>
        <div class="asset_import_row">
            <label class="asset_import_label" for="asset_import_id">Asset ID</label>
            <input class="asset_import_field" id="asset_import_id" type="text" placeholder="Use file name"/>
        </div>
    </div>
    <div id="asset_import_actions">
        <button class="asset_import_button" id="asset_import_cancel">Cancel</button>
        <button class="asset_import_button" id="asset_import_accept">Import</button>
    </div>
</div></div>
<div id="project_scenes_prompt"><div class="project_dialog">
    <div class="project_dialog_body">
        <h2 id="project_scenes_title">Project Scenes</h2>
        <div id="project_scenes_list"></div>
        <div class="project_dialog_message" id="project_scene_message"></div>
    </div>
    <div class="project_dialog_actions">
        <button id="project_scene_close">Close</button>
        <button id="project_scene_startup">Set as Startup Scene</button>
        <button class="project_primary" id="project_scene_open">Open</button>
    </div>
</div></div>
<div id="project_settings_prompt"><div id="project_settings_dialog" class="project_dialog">
    <div class="project_dialog_body">
        <h2>Project Settings</h2>
        <div id="project_settings_file"></div>
        <div class="project_look_row"><label class="project_look_label" for="look_exposure">Exposure</label><input class="project_look_field" type="text" id="look_exposure"/></div>
        <div class="project_look_row"><label class="project_look_label" for="look_sun">Sun Intensity</label><input class="project_look_field" type="text" id="look_sun"/></div>
        <div class="project_look_row"><label class="project_look_label" for="look_sun_dir">Sun X, Y, Z</label><input class="project_look_field" type="text" id="look_sun_dir"/></div>
        <div class="project_look_row"><label class="project_look_label" for="look_background">Background</label><select class="project_look_field" id="look_background"><option value="0">Sky</option><option value="1">Solid Color</option><option value="2">Environment</option><option value="3">Blurred Environment</option></select></div>
        <div class="project_look_row"><label class="project_look_label" for="look_color">Color R, G, B</label><input class="project_look_field" type="text" id="look_color"/></div>
        <div class="project_look_row"><label class="project_look_label" for="look_fxaa">FXAA</label><select class="project_look_field" id="look_fxaa"><option value="off">Off</option><option value="on">On</option></select></div>
        <div class="project_look_row"><label class="project_look_label" for="look_taa">TAA</label><select class="project_look_field" id="look_taa"><option value="off">Off</option><option value="on">On</option></select></div>
        <div class="project_dialog_message" id="project_settings_message"></div>
    </div>
    <div class="project_dialog_actions">
        <button id="project_settings_input">Input Actions...</button>
        <button id="project_settings_cancel">Cancel</button>
        <button id="project_settings_preview">Preview</button>
        <button class="project_primary" id="project_settings_save">Save</button>
    </div>
</div></div>
<div id="input_actions_prompt"><div class="project_dialog">
    <div class="project_dialog_body">
        <h2>Input Actions</h2>
        <div class="project_look_row">
            <input class="project_look_field" id="input_action_name" type="text" placeholder="Action name"/>
            <button class="input_action_button" id="input_action_add">Add</button>
        </div>
        <div id="input_actions_list"></div>
        <div id="input_action_edit">
            <div id="input_selected_action"></div>
            <div id="input_action_keys"></div>
            <button class="input_action_button" id="input_action_record">Record Key</button>
            <button class="input_action_button" id="input_action_remove">Delete Action</button>
        </div>
        <div class="project_dialog_message" id="input_actions_message"></div>
    </div>
    <div class="project_dialog_actions">
        <button id="input_actions_cancel">Cancel</button>
        <button id="input_actions_save" class="project_primary">Save</button>
    </div>
</div></div>
</body>
</rml>
