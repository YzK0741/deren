<rml>
<head><title>deren editor</title><style>
body { width: 100%; height: 100%; margin: 0; font-family: LatoLatin; font-size: 16dp; color: #e9eef4; background-color: #141a21; display: flex; flex-direction: column; }
#toolbar { display: flex; flex-direction: row; align-items: center; box-sizing: border-box; height: 40dp; padding: 0 12dp; background-color: #1d2530; border-bottom: 1dp #34404e; }
#toolbar button { box-sizing: border-box; height: 26dp; margin-right: 8dp; padding: 0 12dp; background-color: #335b80; border: 1dp #5b7894; color: #ffffff; font-size: 14dp; text-align: center; }
#toolbar button:hover { background-color: #487dab; }
#toolbar button:active { background-color: #6b9bc1; }
#rename_field { box-sizing: border-box; width: 220dp; height: 26dp; margin-right: 8dp; padding: 0 8dp; background-color: #111820; border: 1dp #6d8299; color: #ffffff; font-size: 14dp; }
#main { display: flex; flex-direction: row; flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
#outliner { box-sizing: border-box; width: 320dp; height: 100%; overflow: hidden; background-color: #18202a; border-right: 1dp #34404e; }
#viewport { display: flex; flex-direction: row; align-items: center; justify-content: center; flex-grow: 1; flex-shrink: 1; flex-basis: 0; height: 100%; overflow: hidden; background-color: #0b1016; }
#viewport_image { width: 800dp; height: 450dp; }
.row { box-sizing: border-box; display: block; height: 13dp; padding-left: 8dp; white-space: nowrap; }
.row:hover { background-color: #2b3a49; }
.row_name { font-size: 12dp; line-height: 13dp; white-space: pre; pointer-events: none; }
#details { box-sizing: border-box; width: 320dp; height: 100%; padding: 8dp; overflow: hidden; background-color: #18202a; border-left: 1dp #34404e; }
#details_title { display: block; box-sizing: border-box; height: 24dp; font-size: 15dp; line-height: 24dp; color: #cfe0f0; border-bottom: 1dp #34404e; margin-bottom: 6dp; white-space: nowrap; }
#details_empty { display: block; font-size: 13dp; color: #8fa3b8; }
.detail_header { box-sizing: border-box; height: 20dp; margin-top: 8dp; font-size: 12dp; line-height: 20dp; color: #8fa3b8; text-transform: uppercase; }
.detail_row { display: flex; flex-direction: row; align-items: center; box-sizing: border-box; height: 24dp; }
.detail_label { box-sizing: border-box; width: 92dp; font-size: 13dp; line-height: 24dp; color: #cfe0f0; }
.detail_text { box-sizing: border-box; flex-grow: 1; height: 20dp; font-size: 13dp; line-height: 20dp; padding: 0 6dp; color: #9fb3c8; background-color: #111820; border: 1dp #2b3a49; white-space: nowrap; overflow: hidden; }
#details input { box-sizing: border-box; flex-grow: 1; height: 20dp; padding: 0 6dp; background-color: #111820; border: 1dp #4a5b6d; color: #ffffff; font-size: 13dp; }
#detail_visible { box-sizing: border-box; height: 20dp; padding: 0 8dp; background-color: #335b80; border: 1dp #5b7894; color: #ffffff; font-size: 13dp; }
#detail_visible:hover { background-color: #487dab; }
#status { box-sizing: border-box; height: 24dp; padding: 2dp 12dp; background-color: #1d2530; border-top: 1dp #34404e; font-size: 14dp; line-height: 20dp; white-space: nowrap; }
</style></head>
<body>
<div id="toolbar">
<button id="btn_new">New Node</button>
<button id="btn_delete">Delete</button>
<button id="btn_save">Save</button>
<button id="btn_undo">Undo</button>
<button id="btn_redo">Redo</button>
<input id="rename_field" type="text"/>
<button id="btn_rename">Rename</button>
</div>
<div id="main">
<div id="outliner">
    <div id="row_0" class="row" style="visibility: hidden;"><div id="row_0_name" class="row_name"></div></div>
    <div id="row_1" class="row" style="visibility: hidden;"><div id="row_1_name" class="row_name"></div></div>
    <div id="row_2" class="row" style="visibility: hidden;"><div id="row_2_name" class="row_name"></div></div>
    <div id="row_3" class="row" style="visibility: hidden;"><div id="row_3_name" class="row_name"></div></div>
    <div id="row_4" class="row" style="visibility: hidden;"><div id="row_4_name" class="row_name"></div></div>
    <div id="row_5" class="row" style="visibility: hidden;"><div id="row_5_name" class="row_name"></div></div>
    <div id="row_6" class="row" style="visibility: hidden;"><div id="row_6_name" class="row_name"></div></div>
    <div id="row_7" class="row" style="visibility: hidden;"><div id="row_7_name" class="row_name"></div></div>
    <div id="row_8" class="row" style="visibility: hidden;"><div id="row_8_name" class="row_name"></div></div>
    <div id="row_9" class="row" style="visibility: hidden;"><div id="row_9_name" class="row_name"></div></div>
    <div id="row_10" class="row" style="visibility: hidden;"><div id="row_10_name" class="row_name"></div></div>
    <div id="row_11" class="row" style="visibility: hidden;"><div id="row_11_name" class="row_name"></div></div>
    <div id="row_12" class="row" style="visibility: hidden;"><div id="row_12_name" class="row_name"></div></div>
    <div id="row_13" class="row" style="visibility: hidden;"><div id="row_13_name" class="row_name"></div></div>
    <div id="row_14" class="row" style="visibility: hidden;"><div id="row_14_name" class="row_name"></div></div>
    <div id="row_15" class="row" style="visibility: hidden;"><div id="row_15_name" class="row_name"></div></div>
    <div id="row_16" class="row" style="visibility: hidden;"><div id="row_16_name" class="row_name"></div></div>
    <div id="row_17" class="row" style="visibility: hidden;"><div id="row_17_name" class="row_name"></div></div>
    <div id="row_18" class="row" style="visibility: hidden;"><div id="row_18_name" class="row_name"></div></div>
    <div id="row_19" class="row" style="visibility: hidden;"><div id="row_19_name" class="row_name"></div></div>
    <div id="row_20" class="row" style="visibility: hidden;"><div id="row_20_name" class="row_name"></div></div>
    <div id="row_21" class="row" style="visibility: hidden;"><div id="row_21_name" class="row_name"></div></div>
    <div id="row_22" class="row" style="visibility: hidden;"><div id="row_22_name" class="row_name"></div></div>
    <div id="row_23" class="row" style="visibility: hidden;"><div id="row_23_name" class="row_name"></div></div>
    <div id="row_24" class="row" style="visibility: hidden;"><div id="row_24_name" class="row_name"></div></div>
    <div id="row_25" class="row" style="visibility: hidden;"><div id="row_25_name" class="row_name"></div></div>
    <div id="row_26" class="row" style="visibility: hidden;"><div id="row_26_name" class="row_name"></div></div>
    <div id="row_27" class="row" style="visibility: hidden;"><div id="row_27_name" class="row_name"></div></div>
    <div id="row_28" class="row" style="visibility: hidden;"><div id="row_28_name" class="row_name"></div></div>
    <div id="row_29" class="row" style="visibility: hidden;"><div id="row_29_name" class="row_name"></div></div>
    <div id="row_30" class="row" style="visibility: hidden;"><div id="row_30_name" class="row_name"></div></div>
    <div id="row_31" class="row" style="visibility: hidden;"><div id="row_31_name" class="row_name"></div></div>
    <div id="row_32" class="row" style="visibility: hidden;"><div id="row_32_name" class="row_name"></div></div>
    <div id="row_33" class="row" style="visibility: hidden;"><div id="row_33_name" class="row_name"></div></div>
    <div id="row_34" class="row" style="visibility: hidden;"><div id="row_34_name" class="row_name"></div></div>
    <div id="row_35" class="row" style="visibility: hidden;"><div id="row_35_name" class="row_name"></div></div>
    <div id="row_36" class="row" style="visibility: hidden;"><div id="row_36_name" class="row_name"></div></div>
    <div id="row_37" class="row" style="visibility: hidden;"><div id="row_37_name" class="row_name"></div></div>
    <div id="row_38" class="row" style="visibility: hidden;"><div id="row_38_name" class="row_name"></div></div>
    <div id="row_39" class="row" style="visibility: hidden;"><div id="row_39_name" class="row_name"></div></div>
    <div id="row_40" class="row" style="visibility: hidden;"><div id="row_40_name" class="row_name"></div></div>
    <div id="row_41" class="row" style="visibility: hidden;"><div id="row_41_name" class="row_name"></div></div>
    <div id="row_42" class="row" style="visibility: hidden;"><div id="row_42_name" class="row_name"></div></div>
    <div id="row_43" class="row" style="visibility: hidden;"><div id="row_43_name" class="row_name"></div></div>
    <div id="row_44" class="row" style="visibility: hidden;"><div id="row_44_name" class="row_name"></div></div>
    <div id="row_45" class="row" style="visibility: hidden;"><div id="row_45_name" class="row_name"></div></div>
    <div id="row_46" class="row" style="visibility: hidden;"><div id="row_46_name" class="row_name"></div></div>
    <div id="row_47" class="row" style="visibility: hidden;"><div id="row_47_name" class="row_name"></div></div>
    <div id="row_48" class="row" style="visibility: hidden;"><div id="row_48_name" class="row_name"></div></div>
    <div id="row_49" class="row" style="visibility: hidden;"><div id="row_49_name" class="row_name"></div></div>
    <div id="row_50" class="row" style="visibility: hidden;"><div id="row_50_name" class="row_name"></div></div>
    <div id="row_51" class="row" style="visibility: hidden;"><div id="row_51_name" class="row_name"></div></div>
    <div id="row_52" class="row" style="visibility: hidden;"><div id="row_52_name" class="row_name"></div></div>
    <div id="row_53" class="row" style="visibility: hidden;"><div id="row_53_name" class="row_name"></div></div>
    <div id="row_54" class="row" style="visibility: hidden;"><div id="row_54_name" class="row_name"></div></div>
    <div id="row_55" class="row" style="visibility: hidden;"><div id="row_55_name" class="row_name"></div></div>
    <div id="row_56" class="row" style="visibility: hidden;"><div id="row_56_name" class="row_name"></div></div>
    <div id="row_57" class="row" style="visibility: hidden;"><div id="row_57_name" class="row_name"></div></div>
    <div id="row_58" class="row" style="visibility: hidden;"><div id="row_58_name" class="row_name"></div></div>
    <div id="row_59" class="row" style="visibility: hidden;"><div id="row_59_name" class="row_name"></div></div>
    <div id="row_60" class="row" style="visibility: hidden;"><div id="row_60_name" class="row_name"></div></div>
    <div id="row_61" class="row" style="visibility: hidden;"><div id="row_61_name" class="row_name"></div></div>
    <div id="row_62" class="row" style="visibility: hidden;"><div id="row_62_name" class="row_name"></div></div>
    <div id="row_63" class="row" style="visibility: hidden;"><div id="row_63_name" class="row_name"></div></div>
</div>
<div id="viewport">
    <img id="viewport_image" src="deren://scene"/>
</div>
<div id="details">
    <div id="details_title">Details</div>
    <div id="details_empty">Select a node to edit its properties.</div>
    <div id="details_form" style="visibility: hidden;">
        <div class="detail_row"><div class="detail_label">Name</div><input id="detail_name" type="text"/></div>
        <div class="detail_header">Transform</div>
        <div class="detail_row"><div class="detail_label">Position X</div><input id="detail_position_x" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Position Y</div><input id="detail_position_y" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Position Z</div><input id="detail_position_z" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Rotation X</div><input id="detail_rotation_x" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Rotation Y</div><input id="detail_rotation_y" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Rotation Z</div><input id="detail_rotation_z" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Scale X</div><input id="detail_scale_x" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Scale Y</div><input id="detail_scale_y" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Scale Z</div><input id="detail_scale_z" type="text"/></div>
        <div class="detail_header">Actor</div>
        <div class="detail_row"><div class="detail_label">Visible</div><button id="detail_visible">Visible: yes</button></div>
        <div class="detail_row"><div class="detail_label">Flags</div><input id="detail_flags" type="text"/></div>
        <div class="detail_row"><div class="detail_label">Asset</div><div id="detail_asset" class="detail_text">-</div></div>
        <div class="detail_row"><div class="detail_label">Pipeline</div><div id="detail_pipeline" class="detail_text">-</div></div>
    </div>
</div>
</div>
<div id="status"></div>
</body>
</rml>
