[*.cs]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = none
csharp_new_line_before_catch = false
csharp_new_line_before_else = false
csharp_new_line_before_finally = false
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = error
dotnet_diagnostic.IDE1006.severity = error

dotnet_naming_rule.deren_identifiers.symbols = deren_symbols
dotnet_naming_rule.deren_identifiers.style = snake_case
dotnet_naming_rule.deren_identifiers.severity = error
dotnet_naming_symbols.deren_symbols.applicable_kinds = *
dotnet_naming_symbols.deren_symbols.applicable_accessibilities = *
dotnet_naming_style.snake_case.capitalization = all_lower
dotnet_naming_style.snake_case.word_separator = _
