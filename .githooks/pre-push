#!/bin/sh
# The pre-push protocol supplies one line per ref on stdin:
#   <local ref> SP <local sha> SP <remote ref> SP <remote sha>
#
# Two rules:
#   1. master/main are never pushed directly.
#   2. The local gate marker (scripts/check-ci-marker.ps1) names the commit it
#      verified. Push only that commit: a different local_sha has not been gated,
#      even if HEAD has. A deletion (all-zero local_sha) publishes no tree.
#
# The marker is a LOCAL prerequisite, not proof that remote CI passed; PR CI is
# the merge authority (CONTRIBUTING.md).

head=$(git rev-parse --verify HEAD 2>/dev/null) || {
    echo "push refused: cannot resolve HEAD" >&2
    exit 1
}

needs_marker=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue

    case "$remote_ref" in
        refs/heads/master|refs/heads/main)
            echo "push refused: direct pushes to ${remote_ref#refs/heads/} are disabled." >&2
            echo "Use scripts/push.ps1 on a feature branch, open a PR, and merge after CI is green." >&2
            exit 1
            ;;
    esac

    # All-zero local_sha means the ref is being deleted; there is no code to gate.
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac

    # Resolve annotated tags to the commit they name: the marker records commits.
    resolved=$(git rev-parse --verify --quiet "${local_sha}^{commit}") || {
        echo "push refused: cannot resolve $local_ref ($local_sha) to a commit." >&2
        exit 1
    }
    if [ "$resolved" != "$head" ]; then
        echo "push refused: $local_ref would publish $resolved, but the local gate marker verifies HEAD $head." >&2
        echo "Check out and run the gate on the commit you are pushing, or push only HEAD (scripts/push.ps1)." >&2
        exit 1
    fi
    needs_marker=1
done

if [ "$needs_marker" -eq 0 ]; then
    exit 0
fi

if ! command -v pwsh >/dev/null 2>&1; then
    echo "push refused: pwsh is required to validate tmp/local-gate-pass.json" >&2
    exit 1
fi

if ! pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-ci-marker.ps1; then
    echo "push refused: the local gate marker is missing, stale, or does not match HEAD." >&2
    echo "Run scripts/commit.ps1 (it commits and attests) or scripts/run-local-ci.ps1 -Mode Full on a clean HEAD." >&2
    echo "The marker covers the local subset of CI; remote PR CI remains the merge authority." >&2
    exit 1
fi

exit 0
