#!/bin/sh
# Read every ref being pushed (the pre-push protocol supplies them on stdin).
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/master|refs/heads/main)
            echo "push refused: direct pushes to ${remote_ref#refs/heads/} are disabled." >&2
            echo "Use scripts/push.ps1 on a feature branch, open a PR, and merge after CI is green." >&2
            exit 1
            ;;
    esac
done

# The marker is written by scripts/commit.ps1 only after the local gate passes
# on the committed HEAD. The pre-push hook re-runs the same validation so a
# direct `git push` cannot skip the marker check.
if ! command -v pwsh >/dev/null 2>&1; then
    echo "push refused: pwsh is required to validate tmp/ci-pass.json" >&2
    exit 1
fi

if ! pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-ci-marker.ps1; then
    echo "push refused: CI marker is missing, stale, or does not match HEAD." >&2
    echo "Run scripts/commit.ps1 (it commits and attests) or scripts/run-local-ci.ps1 -Mode Full on a clean HEAD." >&2
    exit 1
fi

exit 0
