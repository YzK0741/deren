#clion folders
cmake-build-*/
build-*-clang64/
build-stacktrace-posix/
build-subtilis/
build-subtilis-asan/
build-debug/
build-release/
#sanitizer build (ASan/UBSan, local verification only - see source/tests/)
build-asan/
.idea/

#doxygen generated output
docs/html/
docs/latex/

#compiled shaders: the build produces them (into <build>/shaders), so they are never committed and
#never hand-synced with their .glsl sources - editing a shader and rebuilding is the whole workflow
*.spv

#runtime artifacts (flushed logs; the Dear ImGui layout file is no longer written - io.IniFilename is null - but it stays ignored so a stale one cannot be committed)
debug.log
debug.log.old
deren-debug.log
deren-debug.log.old
deren-crash.log
imgui_layout.ini
# MSVC writes a compiler PDB next to the target when the link line leaves /Fd implied (vc140.pdb in
# the repository root, in practice) - generated output, never a source file
*.pdb
#local startup config (generated from config.example.toml by the setup scripts)
config.toml
.commit-msg.tmp

# A plain out-of-source build directory (cmake -B build): not part of the repository, same as the
# per-configuration ones above. Found tracked once by accident, via compile_commands.json.
/build/

# python bytecode from the project's own tools
__pycache__/
*.pyc

# Captures the app writes into the working directory (F12 / --capture-frames): output, not
# repository content. 'docs/screenshots/*.png' stays tracked - those are the hand-picked README shots.
/screenshot_*.png

# Workspace scratch for measurement runs; durable evidence lives under D:/deren-assets, not the repo.
/tmp/
/docs/reviews/
/docs/superpowers/
/docs/benchmarks/
/docs/research/
# Decompiled proprietary material: untracked reference input for local analysis only.
# It must never be staged or committed.
/docs/references/

# BCP's extraction log is a by-product of scripts/tools/vendor_boost_graph.py, which writes it
# into the output directory. The reproducibility record is headers.json (the SHA-256 manifest),
# not the log.
source/third_party/boost/bcp.log

# Local scratch that the review left in the working tree: editor state, measurement logs, experiment
# trees and the ad-hoc gate/probe scripts they drive. None of it is a required build or test
# dependency - the only tracked reference is CMakeLists' opt-in `if(EXISTS ...)` guard for
# tools/ibl_cuda_spike, which simply skips that benchmark when the tree is absent - and the local gate
# marker treats an untracked file as a dependency the repository does not contain. Ignoring it keeps
# that rule meaningful instead of moving files around. A tool that becomes part of the project moves
# OUT of this block and gets a real home under scripts/ or tools/.
/.vscode/
/*.log
/child_output.txt
/configs/
/--negative-workers/
/--zero-workers/
/tools/face_proximity/
/tools/game_shader_audit/
/tools/game_shader_replay/
/tools/ibl_cuda_spike/
/tools/prepare_toon_reference.py
/tools/reference_toon_probe/
/tools/smolv_probe/
/scripts/gates/check_emissive_occlusion.py
/scripts/gates/local_reflection_probe.py
/scripts/gates/radiance_capture.py
/scripts/gates/toon_reference_shape.py
