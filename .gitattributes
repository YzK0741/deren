# Language statistics: count project code, ignore third-party and non-code folders.
# (Folder-based vendoring replaces the previous extension whitelist, so project
#  sources — cpp/cppm/headers/cmake/glsl — count naturally.)
# Third-party code / assets
source/third_party/** linguist-vendored
# Preserve the upstream bytes checked by Boost's SHA-256 vendor manifest.
source/third_party/boost/** -text
source/third_party/khronos_tonemapping/** -text
source/third_party/meshoptimizer/** -text
source/third_party/yyjson/** -text
asset/** linguist-vendored
# docs/ is project prose (Doxygen INPUT and reference documentation), so it is
# first-party content and deliberately NOT marked linguist-vendored.
# Shell scripts must keep LF endings in the working tree (core.autocrlf=true
# would otherwise check them out as CRLF and break the shebang on POSIX).
*.sh text eol=lf
.githooks/* text eol=lf
asset/laevatain/*.glb filter=lfs diff=lfs merge=lfs -text
asset/flowers/*.ply filter=lfs diff=lfs merge=lfs -text
# README SCREENSHOTS STAY IN PLAIN GIT, deliberately. They are hand-picked presentation assets
# referenced from README.md (and copied by the docs build), they are refreshed rarely, and each is
# 0.3-1 MB: a Git LFS pointer would have to be resolved by every consumer of those files (README
# rendering, a plain checkout, the docs build) for a history cost of a few megabytes. The two large
# MODEL assets above are the ones that go to LFS. `-text` keeps their bytes unnormalized.
docs/screenshots/** -text
