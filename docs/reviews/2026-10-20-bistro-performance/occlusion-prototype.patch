+            deren::utility::vessel::vector<std::uint32_t> level_height;
+        };
+
+        void build_occlusion_pyramid(std::span<std::byte const> const bytes, std::uint32_t const width, std::uint32_t const height,
+                                     std::array<float, 16> const& view, std::array<float, 16> const& projection, occlusion_frame& frame) {
+            frame = {};
+            if (width == 0u || height == 0u || bytes.size() < static_cast<std::size_t>(width) * height * 4u) {
+                return;
+            }
+            glm::mat4 view_matrix{1.0f}, projection_matrix{1.0f};
+            std::memcpy(&view_matrix, view.data(), sizeof(view_matrix));
+            std::memcpy(&projection_matrix, projection.data(), sizeof(projection_matrix));
+            frame.width = width;
+            frame.height = height;
+            frame.view_proj = projection_matrix * view_matrix;
+            frame.focal_x = std::fabs(projection_matrix[0][0]);
+            frame.focal_y = std::fabs(projection_matrix[1][1]);
+            frame.pyramid.resize(static_cast<std::size_t>(width) * height);
+            auto const* const raw = bytes.data();
+            for (std::size_t index = 0; index < frame.pyramid.size(); ++index) {
+                std::uint32_t bits = 0;
+                std::memcpy(&bits, raw + index * 4u, sizeof(bits));
+                float value = 0.0f;
+                std::memcpy(&value, &bits, sizeof(value));
+                frame.pyramid[index] = value;
+            }
+            frame.level_offset.push_back(0u);
+            frame.level_width.push_back(width);
+            frame.level_height.push_back(height);
+            std::uint32_t level_w = width, level_h = height;
+            while (level_w > 1u || level_h > 1u) {
+                std::uint32_t const next_w = std::max(1u, (level_w + 1u) / 2u);
+                std::uint32_t const next_h = std::max(1u, (level_h + 1u) / 2u);
+                std::uint32_t const offset = static_cast<std::uint32_t>(frame.pyramid.size());
+                frame.pyramid.resize(frame.pyramid.size() + static_cast<std::size_t>(next_w) * next_h);
+                float const* const previous = frame.pyramid.data() + frame.level_offset.back();
+                float* const next = frame.pyramid.data() + offset;
+                for (std::uint32_t y = 0; y < next_h; ++y) {
+                    for (std::uint32_t x = 0; x < next_w; ++x) {
+                        float value = -1.0f;
+                        for (std::uint32_t dy = 0; dy < 2u; ++dy) {
+                            for (std::uint32_t dx = 0; dx < 2u; ++dx) {
+                                std::uint32_t const sample_x = x * 2u + dx;
+                                std::uint32_t const sample_y = y * 2u + dy;
+                                if (sample_x < level_w && sample_y < level_h) {
+                                    value = std::max(value, previous[static_cast<std::size_t>(sample_y) * level_w + sample_x]);
+                                }
+                            }
+                        }
+                        next[static_cast<std::size_t>(y) * next_w + x] = value;
+                    }
+                }
+                frame.level_offset.push_back(offset);
+                frame.level_width.push_back(next_w);
+                frame.level_height.push_back(next_h);
+                level_w = next_w;
+                level_h = next_h;
+            }
+            frame.active = true;
+        }
+
+        [[nodiscard]] bool meshlet_is_occluded(occlusion_frame const& frame, std::array<float, 16> const& model, meshlet const& record) {
+            if (!frame.active) {
+                return false;
+            }
+            glm::mat4 model_matrix{1.0f};
+            std::memcpy(&model_matrix, model.data(), sizeof(model_matrix));
+            glm::vec4 const world = model_matrix * glm::vec4(record.center_x, record.center_y, record.center_z, 1.0f);
+            float const model_scale = std::max({glm::length(glm::vec3(model_matrix[0])), glm::length(glm::vec3(model_matrix[1])), glm::length(glm::vec3(model_matrix[2]))});
+            float const world_radius = record.radius * model_scale;
+            glm::vec4 const clip = frame.view_proj * world;
+            if (clip.w <= 1e-4f) {
+                return false;
+            }
+            float const ndc_x = clip.x / clip.w;
+            float const ndc_y = clip.y / clip.w;
+            float const ndc_z = clip.z / clip.w;
+            float const radius_ndc_x = world_radius * frame.focal_x / clip.w;
+            float const radius_ndc_y = world_radius * frame.focal_y / clip.w;
+            float const radius_ndc_z = world_radius / clip.w; // biased small: the conservative direction
+            if (ndc_z - radius_ndc_z > 1.0f || ndc_z + radius_ndc_z < 0.0f ||
+                std::fabs(ndc_x) - radius_ndc_x > 1.0f || std::fabs(ndc_y) - radius_ndc_y > 1.0f) {
+                return false; // outside the frustum: not occluded (and not this test's business)
+            }
+            float const focal = std::max(frame.focal_x * static_cast<float>(frame.width), frame.focal_y * static_cast<float>(frame.height)) * 0.5f;
+            float const radius_px = world_radius * focal / clip.w;
+            float const pixel_x = (ndc_x + 1.0f) * 0.5f * static_cast<float>(frame.width);
+            float const pixel_y = (ndc_y + 1.0f) * 0.5f * static_cast<float>(frame.height); // the captured depth's y convention
+            int const x0 = static_cast<int>(std::floor(pixel_x - radius_px));
+            int const x1 = static_cast<int>(std::ceil(pixel_x + radius_px));
+            int const y0 = static_cast<int>(std::floor(pixel_y - radius_px));
+            int const y1 = static_cast<int>(std::ceil(pixel_y + radius_px));
+            if (x1 <= 0 || y1 <= 0 || x0 >= static_cast<int>(frame.width) || y0 >= static_cast<int>(frame.height)) {
+                return false;
+            }
+            std::uint32_t level = 0u;
+            std::uint32_t const span = static_cast<std::uint32_t>(std::max({x1 - x0, y1 - y0, 1}));
+            while (level + 1u < frame.level_offset.size() && (1u << (level + 1u)) <= span) {
+                ++level;
+            }
+            std::uint32_t const scale = 1u << level;
+            std::uint32_t const level_w = frame.level_width[level];
+            std::uint32_t const level_h = frame.level_height[level];
+            int const clamped_x0 = std::clamp(x0, 0, static_cast<int>(frame.width) - 1);
+            int const clamped_y0 = std::clamp(y0, 0, static_cast<int>(frame.height) - 1);
+            int const clamped_x1 = std::clamp(x1, 0, static_cast<int>(frame.width) - 1);
+            int const clamped_y1 = std::clamp(y1, 0, static_cast<int>(frame.height) - 1);
+            std::uint32_t const lx0 = static_cast<std::uint32_t>(clamped_x0) >> level;
+            std::uint32_t const ly0 = static_cast<std::uint32_t>(clamped_y0) >> level;
+            std::uint32_t const lx1 = std::min(level_w, (static_cast<std::uint32_t>(clamped_x1) + scale) >> level);
+            std::uint32_t const ly1 = std::min(level_h, (static_cast<std::uint32_t>(clamped_y1) + scale) >> level);
+            float far_depth = -1.0f;
+            float const* const level_data = frame.pyramid.data() + frame.level_offset[level];
+            for (std::uint32_t y = ly0; y < ly1; ++y) {
+                for (std::uint32_t x = lx0; x < lx1; ++x) {
+                    far_depth = std::max(far_depth, level_data[static_cast<std::size_t>(y) * level_w + x]);
+                }
+            }
+            return far_depth >= 0.0f && ndc_z - radius_ndc_z > far_depth + 1e-4f;
+        }
