+        /// OCCLUSION-CULL PROTOTYPE's host side (DEREN_OCCLUSION_CULL=1): a max-depth Hi-Z pyramid built from the
+        /// previous frame's depth, plus the conservative meshlet-sphere test. The test is biased towards NOT
+        /// culling (small sphere, the FARTHEST depth per tile, the NEAREST sphere depth), so a meshlet it rejects
+        /// is behind rendered geometry in the frame it was measured against.
+        struct occlusion_frame {
+            bool active = false;
+            std::uint32_t width = 0, height = 0;
+            glm::mat4 view_proj{1.0f};
+            float focal_x = 0.0f, focal_y = 0.0f;
+            deren::utility::vessel::vector<float> pyramid; // level 0 = the depth itself, then 2x2 max downsamples
+            deren::utility::vessel::vector<std::uint32_t> level_offset;
