+        vp::frame_identity frame{.image_index = 0, .slot = 1};
+        auto const slot = vp::instance_for(rr::find(rr::resource_id::top_level_structure)->scope, frame);
+        Binding resolved = table.find(rr::resource_id::top_level_structure, 0, slot);
